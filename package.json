{
  "name": "kerjain-monorepo",
  "version": "1.0.0",
  "description": "Unified runner for Kerjain Frontend & Backend",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "start": "npm --workspace=frontend run start",
    "postinstall": "npm --workspace=frontend run postinstall"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

