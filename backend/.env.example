# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (SUPABASE)
# ------------------------------------------------------------------------------
# String koneksi ke database PostgreSQL.
# Dapatkan dari Dashboard Supabase Anda:
# Masuk ke Project Settings -> Database -> Connection string (URI).
# PENTING: Saat Production, pastikan password diganti dengan password DB Supabase asli.
# Format umum: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-SUPABASE-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret Key digunakan untuk melakukan signing terhadap JWT Token.
# HARUS DI-GENERATE SENDIRI (Jangan gunakan string mudah ditebak).
# Anda bisa generate menggunakan command: openssl rand -hex 32
# PENTING: Wajib diganti dengan string acak baru saat Production agar token aman!
SECRET_KEY="your-super-secret-key-replace-this-in-production"

# Algoritma enkripsi JWT (Biasanya HS256). Tidak perlu diubah.
ALGORITHM="HS256"

# Masa berlaku Access Token (dalam menit).
# Default: 10080 menit (7 hari). Sesuaikan dengan kebutuhan keamanan.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Daftar asal domain (origin) yang diizinkan untuk mengakses API ini.
# - Environment Lokal: http://localhost:3000
# - Production: Ganti dengan domain utama frontend Anda (contoh: https://kerjain.vercel.app)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://kerjain.vercel.app"

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
# Nama project FastAPI yang akan muncul di Swagger UI
PROJECT_NAME="Kerjain API"

# Mode Environment Backend (development/production)
ENVIRONMENT="development"
